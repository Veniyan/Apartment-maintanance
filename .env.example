# Database Configuration
# For PostgreSQL (Production)
DB_URL=jdbc:postgresql://your-db-host:5432/apartmentdb
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# For H2 (Local Development) - use these instead
# DB_URL=jdbc:h2:mem:apartmentdb
# DB_USERNAME=sa
# DB_PASSWORD=

# JWT Configuration
# Generate a secure random key (min 256 bits / 32 characters)
# You can use: openssl rand -base64 32
JWT_SECRET=mySecretKeyForJWT123456789012345678901234567890
JWT_EXPIRATION=86400000

# Note: Copy this file to .env and replace with your actual values
# Never commit .env to version control!
