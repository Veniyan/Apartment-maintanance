# Database Configuration
# Default runtime profile is PostgreSQL.
# For Aiven/PostgreSQL use the full JDBC URL, including sslmode=require when needed.
SPRING_PROFILES_ACTIVE=postgres
DB_URL=jdbc:postgresql://your-aiven-host:19184/defaultdb?sslmode=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# For local H2 fallback instead:
# SPRING_PROFILES_ACTIVE=h2

# JWT Configuration
# Generate a secure random key (min 256 bits / 32 characters)
# You can use: openssl rand -base64 32
JWT_SECRET=mySecretKeyForJWT123456789012345678901234567890
JWT_EXPIRATION=86400000

# Note: Copy this file to .env and replace with your actual values.
# Never commit your real database credentials to version control.
